using Microsoft.AspNetCore.Mvc;
using Cộng_điểm.Models;
using System.Linq;
using Microsoft.EntityFrameworkCore;

namespace Cộng_điểm.Controllers
{
    public class GradeController : Controller
    {
        private readonly ApplicationDbContext _context;

        public GradeController(ApplicationDbContext context)
        {
            _context = context;
        }

        // Action xem danh sách các lớp học
        // GET: /Grade/Index
        public IActionResult Index()
        {
            // Lấy danh sách tất cả các lớp học từ cơ sở dữ liệu
            var listGrade = _context.Grades.ToList();

            // Trả về view "Index" và truyền danh sách lớp học vào view để hiển thị
            return View(listGrade);
        }

        // Action xem chi tiết lớp học và danh sách học sinh
        // GET: /Grade/Details/1
        public IActionResult Details(int id)
        {
            var grade = _context.Grades
                .Include(g => g.Students)
                .FirstOrDefault(g => g.GradeId == id);

            if (grade == null)
            {
                return NotFound();
            }

            return View(grade);
        }

        // Action tạo học sinh mới
        // POST: /Grade/CreateStudent
        [HttpPost]
        public IActionResult CreateStudent(int gradeId, string firstName, string lastName)
        {
            if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(lastName))
            {
                return BadRequest("Tên học sinh không được để trống");
            }

            var grade = _context.Grades.Find(gradeId);
            if (grade == null)
            {
                return NotFound();
            }

            var student = new Student
            {
                FirstName = firstName,
                LastName = lastName,
                GradeId = gradeId
            };

            _context.Students.Add(student);
            _context.SaveChanges();

            return RedirectToAction("Details", new { id = gradeId });
        }

        // Action chỉnh sửa học sinh
        // POST: /Grade/EditStudent
        [HttpPost]
        public IActionResult EditStudent(int studentId, string firstName, string lastName)
        {
            if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(lastName))
            {
                return BadRequest("Tên học sinh không được để trống");
            }

            var student = _context.Students.Find(studentId);
            if (student == null)
            {
                return NotFound();
            }

            student.FirstName = firstName;
            student.LastName = lastName;
            _context.SaveChanges();

            return RedirectToAction("Details", new { id = student.GradeId });
        }

        // Action xóa học sinh
        // POST: /Grade/DeleteStudent
        [HttpPost]
        public IActionResult DeleteStudent(int studentId)
        {
            var student = _context.Students.Find(studentId);
            if (student == null)
            {
                return NotFound();
            }

            int gradeId = student.GradeId;
            _context.Students.Remove(student);
            _context.SaveChanges();

            return RedirectToAction("Details", new { id = gradeId });
        }
    }
}
