@model IEnumerable<dynamic>

<div class="list-group">
    <a href="#" class="list-group-item list-group-item-action active" style="background-color: #28a745; border-color: #28a745;">
        Chủ đề
    </a>
    @foreach (var item in Model)
    {
        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            @item.CategoryName
            <span class="badge bg-primary rounded-pill">@item.BookCount</span>
        </a>
    }
</div>
