@model Buoi5.Models.Book

@{
    ViewData["Title"] = Model.Title;
}

<div class="card shadow-sm border-0 p-4 mb-5 bg-white rounded">
    <div class="row g-5">
        <div class="col-md-5 text-center">
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="~/Content/ImageBooks/@Model.Image" class="img-fluid rounded book-image shadow" alt="@Model.Title" style="max-height: 500px; object-fit: cover;">
            }
            else
            {
                <img src="~/Content/ImageBooks/default.jpg" class="img-fluid rounded book-image shadow" alt="No image">
            }
        </div>
        <div class="col-md-7">
            <h2 class="fw-bold mb-3">@Model.Title</h2>
            
            <div class="d-flex mb-3 text-muted">
                <div class="me-4"><strong>Tác giả:</strong> <span class="text-primary">@Model.Author</span></div>
                <div class="me-4"><strong>Chủ đề:</strong> @Model.Category?.CategoryName</div>
                <div><strong>Đánh giá:</strong> <i class="bi bi-star-fill text-warning"></i><i class="bi bi-star-fill text-warning"></i><i class="bi bi-star-fill text-warning"></i><i class="bi bi-star-fill text-warning"></i><i class="bi bi-star-half text-warning"></i> (20)</div>
            </div>

            <h3 class="text-danger fw-bold mb-4">@Model.Price.ToString("N0") VNĐ <span class="fs-6 text-muted text-decoration-line-through fw-normal ms-2">@( (Model.Price * 1.2m).ToString("N0") ) VNĐ</span></h3>
            
            <div class="mb-4">
                <h5>Mô tả:</h5>
                <p class="text-muted" style="line-height: 1.6;">
                    @(string.IsNullOrEmpty(Model.Description) ? "Đang cập nhật..." : Model.Description)
                </p>
            </div>
            
            <div class="d-flex align-items-center mb-4">
                <strong class="me-3">Số lượng:</strong>
                <input type="number" class="form-control text-center" value="1" min="1" max="100" style="width: 80px;">
            </div>

            <div class="d-grid gap-2 d-md-block">
                <button class="btn btn-outline-primary btn-lg me-md-2" type="button"><i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng</button>
                <button class="btn btn-danger btn-lg text-white px-5" type="button">Mua ngay</button>
            </div>
            
            <div class="mt-5">
                <a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
                <span class="mx-2">|</span>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="text-decoration-none">Chỉnh sửa sách</a>
            </div>
        </div>
    </div>
</div>
