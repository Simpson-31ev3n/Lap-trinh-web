@model Buoi5.Models.Book

@{
    ViewData["Title"] = "Xóa sách";
}

<h2>Xóa sách</h2>
<h4 class="text-danger">Bạn có chắc chắn muốn xóa cuốn sách này không?</h4>
<hr />
<div class="card shadow-sm p-4">
    <dl class="row">
        <dt class="col-sm-2">Tên sách</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        
        <dt class="col-sm-2">Tác giả</dt>
        <dd class="col-sm-10">@Model.Author</dd>
        
        <dt class="col-sm-2">Giá</dt>
        <dd class="col-sm-10">@Model.Price.ToString("N0") VNĐ</dd>
        
        <dt class="col-sm-2">Chủ đề</dt>
        <dd class="col-sm-10">@Model.Category?.CategoryName</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="mt-4">
            <button type="submit" class="btn btn-danger px-4">Xóa</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
        </div>
    </form>
</div>
