@model IEnumerable<Buoi5.Models.Book>

@{
    ViewData["Title"] = "Danh sách Sách";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Trang chủ</h2>
    <a asp-action="Create" class="btn btn-success">Thêm sách mới</a>
</div>

<div class="row">
    @foreach (var item in Model) {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(item.Image))
                {
                    <img src="~/Content/ImageBooks/@item.Image" class="card-img-top book-image p-3" alt="@item.Title" style="height: 250px; object-fit: contain;">
                }
                else
                {
                    <img src="~/Content/ImageBooks/default.jpg" class="card-img-top book-image p-3" alt="No image" style="height: 250px; object-fit: contain;">
                }
                
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-truncate" title="@item.Title">@item.Title</h5>
                    <p class="card-text text-muted">@item.Category?.CategoryName</p>
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <span class="text-danger fw-bold fs-5">@item.Price.ToString("N0") VNĐ</span>
                    </div>
                </div>
                <div class="card-footer bg-white border-top-0 d-flex justify-content-around pb-3">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm px-3">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm px-3 text-white">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm px-3">Xóa</a>
                </div>
            </div>
        </div>
    }
</div>
